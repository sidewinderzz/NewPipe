<?xml version="1.0" encoding="utf-8"?>
<!-- SubsPipe: "Add subscriptions" screen (channel search + list import) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/subspipe_pill_field"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="4dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_search"
            app:tint="?android:attr/textColorSecondary" />

        <EditText
            android:id="@+id/channelSearchInput"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/subspipe_channel_search_hint"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:textSize="15sp" />

        <ImageButton
            android:id="@+id/channelSearchClear"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/subspipe_clear_search"
            android:src="@drawable/ic_close"
            android:visibility="gone"
            app:tint="?android:attr/textColorSecondary"
            tools:visibility="visible" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/channelSearchProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:indeterminate="true"
        android:visibility="invisible" />

    <TextView
        android:id="@+id/channelSearchStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="24dp"
        android:textColor="?android:attr/textColorSecondary"
        android:visibility="gone"
        tools:text="No channels found" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/channelResults"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/importPanel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/subscriptionCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="You follow 189 channels" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/subspipe_channel_search_intro"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="10dp"
                android:text="@string/subspipe_import_header"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/importCsvRow"
                style="@style/SubsPipeImportRow">

                <ImageView
                    style="@style/SubsPipeImportRowIcon"
                    android:src="@drawable/ic_file_download" />

                <LinearLayout style="@style/SubsPipeImportRowText">

                    <TextView
                        style="@style/SubsPipeImportRowTitle"
                        android:text="@string/subspipe_import_csv" />

                    <TextView
                        style="@style/SubsPipeImportRowSummary"
                        android:text="@string/subspipe_import_csv_summary" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/importBackupRow"
                style="@style/SubsPipeImportRow"
                android:layout_marginTop="10dp">

                <ImageView
                    style="@style/SubsPipeImportRowIcon"
                    android:src="@drawable/ic_backup" />

                <LinearLayout style="@style/SubsPipeImportRowText">

                    <TextView
                        style="@style/SubsPipeImportRowTitle"
                        android:text="@string/subspipe_import_backup" />

                    <TextView
                        style="@style/SubsPipeImportRowSummary"
                        android:text="@string/subspipe_import_backup_summary" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/subspipe_takeout_help"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/openTakeout"
                style="@style/SubsPipePillButton.Tonal"
                android:layout_marginTop="10dp"
                android:text="@string/subspipe_open_takeout" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
